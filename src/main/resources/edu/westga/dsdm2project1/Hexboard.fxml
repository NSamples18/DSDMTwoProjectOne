<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="680" prefWidth="760"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.westga.dsdm2project1.view.HexQueensView">
    <top>
        <VBox spacing="8.0">
            <padding>
                <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="Board size:"/>
                <TextField fx:id="boardSizeField" prefColumnCount="4"/>
                <Label text="Cell size:"/>
                <TextField fx:id="cellSizeField" prefColumnCount="4"/>
                <Label text="Starter solution:"/>
                <ComboBox fx:id="starterAlgorithmBox" prefWidth="145"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="Repetitions (k):"/>
                <TextField fx:id="repetitionsField" prefColumnCount="4"/>
                <Label text="Time limit (seconds):"/>
                <TextField fx:id="timeLimitField" prefColumnCount="4"/>
                <Button text="New Board" onAction="#handleNewBoard"/>
            </HBox>
            <Label fx:id="messageLabel" style="-fx-text-fill: firebrick;"/>
            <Label fx:id="queenCountLabel" text="Queens: 0"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" pannable="true">
            <StackPane minWidth="-Infinity" minHeight="-Infinity">
                <Pane fx:id="boardPane"
                      minWidth="-Infinity" minHeight="-Infinity"
                      maxWidth="-Infinity" maxHeight="-Infinity"/>
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>